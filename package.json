{
  "name": "spelsajt",
  "version": "0.1.0",
  "private": true,
  "description": "A high-quality play-money blackjack and roulette platform.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:test": "supabase test db --local",
    "db:verify": "supabase db reset --local && pnpm db:test && pnpm db:lint",
    "lint": "turbo run lint",
    "rulesets:check": "pnpm --filter @spelsajt/config rulesets:check",
    "schemas:check": "pnpm --filter @spelsajt/config schemas:check && pnpm --filter @spelsajt/contracts schemas:check",
    "schemas:generate": "pnpm --filter @spelsajt/config schemas:generate && pnpm --filter @spelsajt/contracts schemas:generate",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm schemas:check && pnpm rulesets:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "supabase": "2.114.0",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
