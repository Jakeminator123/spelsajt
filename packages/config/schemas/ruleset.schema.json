{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "type": "string",
      "const": "play-money"
    },
    "currency": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "PLAY"
        },
        "fractionDigits": {
          "type": "number",
          "const": 0
        },
        "startingBalance": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      },
      "required": [
        "code",
        "fractionDigits",
        "startingBalance"
      ],
      "additionalProperties": false
    },
    "blackjack": {
      "type": "object",
      "properties": {
        "decks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "dealerHitsSoft17": {
          "type": "boolean"
        },
        "blackjackPayout": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "denominator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "hit"
            },
            {
              "type": "string",
              "const": "stand"
            },
            {
              "type": "string",
              "const": "double"
            },
            {
              "type": "string",
              "const": "split"
            }
          ],
          "items": {
            "not": {}
          }
        },
        "maxSplits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "insurance": {
          "type": "boolean"
        },
        "surrender": {
          "type": "boolean"
        },
        "resplit": {
          "type": "boolean"
        }
      },
      "required": [
        "decks",
        "dealerHitsSoft17",
        "blackjackPayout",
        "actions",
        "maxSplits",
        "insurance",
        "surrender",
        "resplit"
      ],
      "additionalProperties": false
    },
    "roulette": {
      "type": "object",
      "properties": {
        "pockets": {
          "type": "number",
          "const": 37
        },
        "minimumPocket": {
          "type": "number",
          "const": 0
        },
        "maximumPocket": {
          "type": "number",
          "const": 36
        },
        "zeroes": {
          "type": "number",
          "const": 1
        },
        "betTypes": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "straight"
            },
            {
              "type": "string",
              "const": "split"
            },
            {
              "type": "string",
              "const": "street"
            },
            {
              "type": "string",
              "const": "corner"
            },
            {
              "type": "string",
              "const": "six-line"
            },
            {
              "type": "string",
              "const": "column"
            },
            {
              "type": "string",
              "const": "dozen"
            },
            {
              "type": "string",
              "const": "red-black"
            },
            {
              "type": "string",
              "const": "odd-even"
            },
            {
              "type": "string",
              "const": "low-high"
            }
          ],
          "items": {
            "not": {}
          }
        }
      },
      "required": [
        "pockets",
        "minimumPocket",
        "maximumPocket",
        "zeroes",
        "betTypes"
      ],
      "additionalProperties": false
    },
    "fairness": {
      "type": "object",
      "properties": {
        "algorithmId": {
          "type": "string",
          "const": "pf-v1"
        },
        "commitment": {
          "type": "string",
          "const": "sha256"
        },
        "stream": {
          "type": "string",
          "const": "hmac-sha256"
        },
        "boundedInteger": {
          "type": "string",
          "const": "rejection-sampling"
        },
        "blackjackShuffle": {
          "type": "string",
          "const": "fisher-yates"
        }
      },
      "required": [
        "algorithmId",
        "commitment",
        "stream",
        "boundedInteger",
        "blackjackShuffle"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "mode",
    "currency",
    "blackjack",
    "roulette",
    "fairness"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.spelsajt.local/ruleset.schema.json",
  "title": "Spelsajt versioned ruleset"
}
