{
  "$schema": "../schemas/system-model.schema.json",
  "schemaVersion": 1,
  "id": "play-money-mvp",
  "title": "Play-money MVP systemkarta",
  "nodes": [
    {
      "id": "node.web-controls",
      "label": "Spelyta och kontroller",
      "lane": "web",
      "owner": "frontend",
      "source": "apps/web/src/app/page.tsx",
      "maturity": {
        "runtime": "partial",
        "contract": "none",
        "verification": "none",
        "lifecycle": "planned"
      },
      "summary": "En statisk webbscaffold finns; kontroller som skapar GameCommand är ännu planerade."
    },
    {
      "id": "node.command-api",
      "label": "Command API",
      "lane": "server",
      "owner": "backend",
      "source": "docs/SYSTEM_CANVAS.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Planerad idempotent ingress för versionslåsta GameCommand-payloads."
    },
    {
      "id": "node.game-core",
      "label": "Game core",
      "lane": "engine",
      "owner": "backend",
      "source": "packages/game-core/src/index.ts",
      "maturity": {
        "runtime": "partial",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Har regelprojektion och rena hjälpfunktioner men saknar kompletta state machines."
    },
    {
      "id": "node.fairness",
      "label": "Fairness-kärna",
      "lane": "engine",
      "owner": "backend",
      "source": "packages/fairness/src/index.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Skapar verifierbar byte-stream och unbiased mappning för shuffle och pocket."
    },
    {
      "id": "node.ledger",
      "label": "PLAY-ledger",
      "lane": "data",
      "owner": "backend",
      "source": "supabase/migrations/20260817231223_initial_play_money_schema.sql",
      "maturity": {
        "runtime": "partial",
        "contract": "none",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Databasschemat finns; den atomiska command- och settlementtjänsten återstår."
    },
    {
      "id": "node.event-stream",
      "label": "Sekvensnumrerade events",
      "lane": "server",
      "owner": "shared",
      "source": "packages/contracts/src/index.ts",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Planerad GameEvent-ström med reconnect från senaste sekvensnummer."
    },
    {
      "id": "node.presentation",
      "label": "Reaction Planner",
      "lane": "presentation",
      "owner": "frontend",
      "source": "docs/PRESENTATION_AI.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "none",
        "lifecycle": "planned"
      },
      "summary": "Översätter semantiska events till godkända presentationsintentioner."
    },
    {
      "id": "node.scene",
      "label": "2D/3D-scen",
      "lane": "presentation",
      "owner": "frontend",
      "source": "apps/web/src/app/_components/casino-scene.tsx",
      "maturity": {
        "runtime": "partial",
        "contract": "none",
        "verification": "none",
        "lifecycle": "active"
      },
      "summary": "Visuell scaffold finns men är ännu inte driven av inspelade GameEvents."
    },
    {
      "id": "node.verifier",
      "label": "Fairness-verifierare",
      "lane": "web",
      "owner": "shared",
      "source": "packages/fairness/src/browser.ts",
      "maturity": {
        "runtime": "partial",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "planned"
      },
      "summary": "Web Crypto-stöd finns; användargränssnittet för rundverifiering återstår."
    }
  ],
  "connections": [
    { "from": "node.web-controls", "to": "node.command-api", "label": "GameCommand" },
    { "from": "node.command-api", "to": "node.game-core", "label": "validerad avsikt" },
    { "from": "node.fairness", "to": "node.game-core", "label": "deterministiska bytes" },
    { "from": "node.game-core", "to": "node.ledger", "label": "ledger intent" },
    { "from": "node.fairness", "to": "node.ledger", "label": "commit och reveal" },
    { "from": "node.ledger", "to": "node.event-stream", "label": "committat resultat" },
    { "from": "node.event-stream", "to": "node.presentation", "label": "GameEvent" },
    { "from": "node.presentation", "to": "node.scene", "label": "presentation intent" },
    { "from": "node.event-stream", "to": "node.verifier", "label": "round data" }
  ],
  "interfaces": [
    {
      "id": "http.health",
      "kind": "http",
      "method": "GET",
      "path": "/health",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Processhälsa för driftkontroll.",
      "accepts": [],
      "returns": "HealthResponse"
    },
    {
      "id": "http.status",
      "kind": "http",
      "method": "GET",
      "path": "/v1/status",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Publicerar play-money-läge och frysta rulesetprojektioner.",
      "accepts": [],
      "returns": "ServiceStatus"
    },
    {
      "id": "http.commands",
      "kind": "http",
      "method": "POST",
      "path": "/v1/tables/{tableId}/commands",
      "source": "docs/SYSTEM_CANVAS.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Föreslagen gemensam ingress; ingen endpoint per animation eller spelhandling.",
      "accepts": ["PLACE_BET", "BLACKJACK_ACTION", "ROULETTE_SPIN"],
      "returns": "CommandAck"
    },
    {
      "id": "http.snapshot",
      "kind": "http",
      "method": "GET",
      "path": "/v1/tables/{tableId}/snapshot",
      "source": "docs/SYSTEM_CANVAS.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Föreslagen reconnect-yta för auktoritativt bordstillstånd.",
      "accepts": [],
      "returns": "GameSnapshot"
    },
    {
      "id": "realtime.server-ready",
      "kind": "realtime",
      "event": "server.ready",
      "source": "apps/game-server/src/realtime.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "none",
        "lifecycle": "active"
      },
      "summary": "Bekräftar Socket.IO-anslutningen; är ännu inte Zod-kontrakterad.",
      "payload": "ServerReady",
      "eventTypes": []
    },
    {
      "id": "realtime.game-event",
      "kind": "realtime",
      "event": "game.event",
      "source": "docs/SYSTEM_CANVAS.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Föreslagen enda kanal för sekvensnumrerade semantiska events.",
      "payload": "GameEvent",
      "eventTypes": [
        "round.started",
        "blackjack.card.dealt",
        "roulette.result",
        "round.settled",
        "reaction.cue"
      ]
    },
    {
      "id": "realtime.table-snapshot",
      "kind": "realtime",
      "event": "table.snapshot",
      "source": "docs/SYSTEM_CANVAS.md",
      "maturity": {
        "runtime": "absent",
        "contract": "zod-v1",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "Föreslagen snapshot efter anslutning eller sekvensgap.",
      "payload": "GameSnapshot",
      "eventTypes": []
    }
  ],
  "presentationCues": [
