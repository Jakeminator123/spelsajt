  "scenarios": [
    {
      "id": "scenario.blackjack-basic",
      "game": "blackjack",
      "label": "Blackjack: insats till reaktion",
      "summary": "Textflöde för en verifierbar hand som slutar i förlust och en sympatisk dealerreaktion.",
      "steps": [
        {
          "id": "blackjack.command-place-bet",
          "kind": "command",
          "nodeId": "node.web-controls",
          "interfaceId": "http.commands",
          "commandType": "PLACE_BET",
          "label": "Spelaren satsar",
          "detail": "Webben skickar ett idempotent PLACE_BET med heltalsbelopp i PLAY."
        },
        {
          "id": "blackjack.reserve-ledger",
          "kind": "system",
          "nodeId": "node.ledger",
          "label": "Insatsen reserveras",
          "detail": "Servern ska debitera och skapa rundan i samma databastransaktion."
        },
        {
          "id": "blackjack.event-round-started",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "round.started",
          "label": "Commitment publiceras",
          "detail": "Frontend får commitment och ruleset innan några kort presenteras."
        },
        {
          "id": "blackjack.shuffle",
          "kind": "system",
          "nodeId": "node.fairness",
          "label": "Verifierbar shuffle",
          "detail": "Fairness-kärnan skapar samma sexlekssko i Node och Web Crypto."
        },
        {
          "id": "blackjack.event-card",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "blackjack.card.dealt",
          "label": "Kort-event levereras",
          "detail": "Eventet anger mottagare, handindex och om kortet ska visas."
        },
        {
          "id": "blackjack.animation-deal",
          "kind": "animation",
          "nodeId": "node.scene",
          "cueId": "blackjack.deal-card",
          "label": "Deal-animation",
          "detail": "Animation Director mappar eventet till en godkänd deal-intention."
        },
        {
          "id": "blackjack.command-stand",
          "kind": "command",
          "nodeId": "node.command-api",
          "interfaceId": "http.commands",
          "commandType": "BLACKJACK_ACTION",
          "label": "Spelaren stannar",
          "detail": "BLACKJACK_ACTION bär action=stand; UI väntar på serverns events."
        },
        {
          "id": "blackjack.resolve",
          "kind": "system",
          "nodeId": "node.game-core",
          "label": "Motorn avgör",
          "detail": "Den framtida state machinen spelar dealerturn och producerar ledger intent plus events."
        },
        {
          "id": "blackjack.event-settled",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "round.settled",
          "label": "Rundan är settled",
          "detail": "Saldo, payout, outcome och avslöjat server seed kommer från backend."
        },
        {
          "id": "blackjack.event-reaction",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "reaction.cue",
          "label": "Reaktionsintention levereras",
          "detail": "Backendens deterministiska policy väljer actor, mood och intensity; inga klippnamn skickas."
        },
        {
          "id": "blackjack.animation-loss",
          "kind": "animation",
          "nodeId": "node.presentation",
          "cueId": "blackjack.reaction",
          "label": "Sympatisk reaktion",
          "detail": "Frontend mappar actor och mood till en godkänd reaktion; AI får bara förfina en eventuell replik."
        },
        {
          "id": "blackjack.verify",
          "kind": "system",
          "nodeId": "node.verifier",
          "label": "Spelaren verifierar",
          "detail": "Webbläsaren reproducerar shufflen från seed, nonce och ruleset."
        }
      ]
    },
    {
      "id": "scenario.roulette-basic",
      "game": "roulette",
      "label": "Roulette: insats till landning",
      "summary": "Textflöde för en verifierbar spin som landar på serverns pocket och slutar i vinst.",
      "steps": [
        {
          "id": "roulette.command-place-bet",
          "kind": "command",
          "nodeId": "node.web-controls",
          "interfaceId": "http.commands",
          "commandType": "PLACE_BET",
          "label": "Spelaren placerar marker",
          "detail": "Bettingmattan samlar spelarens avsikt; nuvarande v1-kontrakt behöver utökas med betposition."
        },
        {
          "id": "roulette.reserve-ledger",
          "kind": "system",
          "nodeId": "node.ledger",
          "label": "Insatsen reserveras",
          "detail": "Den auktoritativa transaktionen låser saldo och runda innan spin."
        },
        {
          "id": "roulette.event-round-started",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "round.started",
          "label": "Commitment publiceras",
          "detail": "Klienten ser commitment, spel och ruleset före resultatet."
        },
        {
          "id": "roulette.command-spin",
          "kind": "command",
          "nodeId": "node.command-api",
          "interfaceId": "http.commands",
          "commandType": "ROULETTE_SPIN",
          "label": "Spin begärs",
          "detail": "ROULETTE_SPIN begär settlement men bestämmer aldrig pocket i klienten."
        },
        {
          "id": "roulette.derive-pocket",
          "kind": "system",
          "nodeId": "node.fairness",
          "label": "Pocket härleds",
          "detail": "Rejection sampling mappar byte-streamen unbiased till 0–36."
        },
        {
          "id": "roulette.event-result",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "roulette.result",
          "label": "Resultatet levereras",
          "detail": "roulette.result är enda sanningen för vilket nummer scenen ska visa."
        },
        {
          "id": "roulette.animation-land",
          "kind": "animation",
          "nodeId": "node.scene",
          "cueId": "roulette.land-pocket",
          "label": "Hjul och boll landar",
          "detail": "Animationen bromsar mot backendens pocket och har en textfallback."
        },
        {
          "id": "roulette.settle-ledger",
          "kind": "system",
          "nodeId": "node.ledger",
          "label": "Payout bokförs",
          "detail": "Motorn räknar payout och ledgern committar nytt PLAY-saldo atomiskt."
        },
        {
          "id": "roulette.event-settled",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "round.settled",
          "label": "Rundan är settled",
          "detail": "Frontend får outcome=win, payout, saldo och server seed."
        },
        {
          "id": "roulette.event-reaction",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "reaction.cue",
          "label": "Reaktionsintention levereras",
          "detail": "Backendens deterministiska policy väljer actor, mood och intensity; inga klippnamn skickas."
        },
        {
          "id": "roulette.animation-win",
          "kind": "animation",
          "nodeId": "node.presentation",
          "cueId": "roulette.reaction",
          "label": "Vinstreaktion",
          "detail": "Frontend mappar actor och mood till en godkänd reaktion utan att AI påverkar utfallet."
        },
        {
          "id": "roulette.verify",
          "kind": "system",
          "nodeId": "node.verifier",
          "label": "Spelaren verifierar",
          "detail": "Webbläsaren reproducerar pocket från samma fairness-input."
        }
      ]
    }
  ]
}
