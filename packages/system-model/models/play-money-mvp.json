{
  "$schema": "../schemas/system-model.schema.json",
  "schemaVersion": 2,
  "id": "play-money-mvp",
  "title": "Play-money MVP systemkarta",
  "nodes": [
    {
      "id": "node.web-controls",
      "label": "Spelyta och kontroller",
      "lane": "web",
      "owner": "frontend",
      "source": "apps/web/src/app/page.tsx",
      "maturity": {
        "runtime": "partial",
        "contract": "zod-v2",
        "verification": "fixture-only",
        "lifecycle": "planned"
      },
      "summary": "En visuell webbscaffold finns; kontroller som skickar v2 GameCommand till servern är ännu planerade."
    },
    {
      "id": "node.command-api",
      "label": "Command API",
      "lane": "server",
      "owner": "backend",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Supabase-authentiserad, ägarisolerad och idempotent ingress för revisionslåsta v2 GameCommand-payloads med atomisk Postgres-persistens."
    },
    {
      "id": "node.game-core",
      "label": "Game core",
      "lane": "engine",
      "owner": "backend",
      "source": "packages/game-core/src/index.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Rena TypeScript-state-machines implementerar blackjack och europeisk roulette med injicerad fairness, semantiska domänevents och ledger intents."
    },
    {
      "id": "node.fairness",
      "label": "Fairness-kärna",
      "lane": "engine",
      "owner": "backend",
      "source": "packages/fairness/src/index.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Skapar verifierbar byte-stream och unbiased mappning för blackjackshuffle och roulettepocket."
    },
    {
      "id": "node.ledger",
      "label": "PLAY-ledger",
      "lane": "data",
      "owner": "backend",
      "source": "supabase/migrations/20260818053717_durable_game_command_repository.sql",
      "maturity": {
        "runtime": "implemented",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Motorernas PLAY-intents, wallet-saldo, fairness, state, events och command receipt committas atomiskt i privat Postgres med RLS och utan browser-grants."
    },
    {
      "id": "node.event-stream",
      "label": "Sekvensnumrerade events",
      "lane": "server",
      "owner": "shared",
      "source": "packages/contracts/src/v2.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Application service lagrar validerade v2-events med stigande tabellsekvens i Postgres; transaktionell NOTIFY och återläsning av den committade raden levererar dem över flera serverinstanser. Relayfel kopplar ned sockets utan tyst lucka, och samma process återupprättar en ny LISTEN-session innan den blir redo igen."
    },
    {
      "id": "node.presentation",
      "label": "Reaction Planner",
      "lane": "presentation",
      "owner": "frontend",
      "source": "apps/web/src/app/_components/scene/presentation.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Validerar v2-domänevents och härleder uttömmande lokala presentationsintentioner; någon reaction.cue transporteras inte av backend."
    },
    {
      "id": "node.scene",
      "label": "2D/3D-scen",
      "lane": "presentation",
      "owner": "frontend",
      "source": "apps/web/src/app/_components/casino-scene.tsx",
      "maturity": {
        "runtime": "partial",
        "contract": "zod-v2",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Den responsiva 3D-scenen konsumerar Reaction Planner-state från ett schema-validerat v2-demotranscript; liveleverans från servern återstår."
    },
    {
      "id": "node.verifier",
      "label": "Fairness-verifierare",
      "lane": "web",
      "owner": "shared",
      "source": "packages/fairness/src/browser.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "none",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Web Crypto reproducerar commitment, slutlig roulettepocket och slutlig blackjackkortordning exakt som Node; ett spelar-UI återstår."
    }
  ],
  "connections": [
    { "from": "node.web-controls", "to": "node.command-api", "label": "GameCommand v2" },
    { "from": "node.command-api", "to": "node.game-core", "label": "validerad avsikt" },
    { "from": "node.fairness", "to": "node.game-core", "label": "deterministiska bytes" },
    { "from": "node.game-core", "to": "node.ledger", "label": "ledger intent" },
    { "from": "node.fairness", "to": "node.ledger", "label": "commit och reveal" },
    { "from": "node.ledger", "to": "node.event-stream", "label": "committat resultat" },
    { "from": "node.event-stream", "to": "node.presentation", "label": "GameEvent v2" },
    { "from": "node.presentation", "to": "node.scene", "label": "presentation intent" },
    { "from": "node.event-stream", "to": "node.verifier", "label": "fairness och runddata" }
  ],
  "interfaces": [
    {
      "id": "http.health",
      "kind": "http",
      "method": "GET",
      "path": "/health",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Processhälsa för driftkontroll.",
      "accepts": [],
      "returns": "HealthResponse"
    },
    {
      "id": "http.status",
      "kind": "http",
      "method": "GET",
      "path": "/v1/status",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "partial",
        "lifecycle": "active"
      },
      "summary": "Publicerar play-money-läge och aktiv rulesetprojektion; routen är inte speltransportens versionsgräns.",
      "accepts": [],
      "returns": "ServiceStatus"
    },
    {
      "id": "http.ready",
      "kind": "http",
      "method": "GET",
      "path": "/ready",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "ad-hoc",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Trafikberedskap som kräver det migrerade privata Postgres-spelschemat och ett aktivt committed-event-relä; förlorad relay gör instansen oreado och kopplar ned dess sockets tills en ny LISTEN-session har etablerats.",
      "accepts": [],
      "returns": "ReadinessResponse"
    },
    {
      "id": "http.commands",
      "kind": "http",
      "method": "POST",
      "path": "/v2/tables/{tableId}/commands",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Gemensam autentiserad ingress för v2 commands med ägarisolering, revision och hållbart idempotent replay i en atomisk Postgres-repository.",
      "accepts": [
        "PREPARE_ROUND",
        "BLACKJACK_PLACE_BET",
        "BLACKJACK_ACTION",
        "ROULETTE_PLACE_BETS",
        "ROULETTE_SPIN"
      ],
      "returns": "CommandAckV2"
    },
    {
      "id": "http.snapshot",
      "kind": "http",
      "method": "GET",
      "path": "/v2/tables/{tableId}/snapshot",
      "source": "apps/game-server/src/app.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Autentiserad reconnect-yta för ett validerat auktoritativt v2-bordssnapshot från hållbar Postgres-state.",
      "accepts": [],
      "returns": "GameSnapshotV2"
    },
    {
      "id": "realtime.server-ready",
      "kind": "realtime",
      "event": "server.ready",
      "source": "apps/game-server/src/realtime.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Bekräftar Socket.IO-anslutningen med ett strikt, versionslåst och direkt socket-testat v2-payload; Supabase-token omverifieras därefter periodiskt och ogiltig eller identitetsändrad session kopplas ned.",
      "payload": "ServerReadyV2",
      "eventTypes": []
    },
    {
      "id": "realtime.table-subscribe",
      "kind": "realtime",
      "event": "table.subscribe",
      "source": "apps/game-server/src/realtime.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Autentiserad och ägarisolerad prenumeration med klientens senaste sekvens och ett validerat subscription-ack.",
      "payload": "TableSubscriptionV2",
      "eventTypes": []
    },
    {
      "id": "realtime.game-event",
      "kind": "realtime",
      "event": "game.event",
      "source": "apps/game-server/src/realtime.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Enda livekanalen för committade sekvensnumrerade v2-domänevents; Postgres-reläet levererar över serverinstanser och fail-closed nedkoppling tvingar snapshotåterankring efter relayfel. Samma serverprocess kan återgå till redo efter en ny LISTEN-session.",
      "payload": "GameEvent",
      "eventTypes": [
        "round.prepared",
        "round.started",
        "blackjack.bet.accepted",
        "blackjack.card.dealt",
        "blackjack.card.revealed",
        "blackjack.action.accepted",
        "blackjack.hand.split",
        "blackjack.turn.changed",
        "blackjack.hand.settled",
        "roulette.betting.opened",
        "roulette.bet.placed",
        "roulette.bets.locked",
        "roulette.spin.started",
        "roulette.result",
        "roulette.bet.settled",
        "round.settled"
      ]
    },
    {
      "id": "realtime.table-snapshot",
      "kind": "realtime",
      "event": "table.snapshot",
      "source": "apps/game-server/src/realtime.ts",
      "maturity": {
        "runtime": "implemented",
        "contract": "zod-v2",
        "verification": "direct",
        "lifecycle": "active"
      },
      "summary": "Validerat v2-snapshot som sekvensankare efter autentiserad anslutning eller reconnect.",
      "payload": "GameSnapshot",
      "eventTypes": []
    }
  ],
