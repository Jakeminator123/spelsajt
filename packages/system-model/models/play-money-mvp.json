  "scenarios": [
    {
      "id": "scenario.blackjack-basic",
      "game": "blackjack",
      "label": "Blackjack: förberedelse till verifierat split-resultat",
      "summary": "V2-flöde där application service, Postgres-ledger och motorn driver blackjack från prepare till settlement; liveleverans och livepresentation återstår.",
      "steps": [
        {
          "id": "blackjack.command-prepare",
          "kind": "command",
          "nodeId": "node.web-controls",
          "interfaceId": "http.commands",
          "commandType": "PREPARE_ROUND",
          "label": "Bordet förbereds",
          "detail": "Webben begär en ny blackjackrunda utan att bestämma seed, kort eller utfall."
        },
        {
          "id": "blackjack.event-prepared",
          "kind": "event",
          "nodeId": "node.event-stream",
          "interfaceId": "realtime.game-event",
          "eventType": "round.prepared",
          "label": "Fairness är låst",
          "detail": "V2-eventet publicerar commitment, nonce och mvp-v2-rulesethash före insatsen."
        },
        {
          "id": "blackjack.animation-prepared",
          "kind": "animation",
          "nodeId": "node.presentation",
          "cueId": "blackjack.round-prepared",
          "label": "Scenen nollställs",
          "detail": "Reaction Planner härleder en deterministisk reset-intention från round.prepared."
        },
        {
          "id": "blackjack.command-place-bet",
          "kind": "command",
          "nodeId": "node.web-controls",
          "interfaceId": "http.commands",
          "commandType": "BLACKJACK_PLACE_BET",
          "label": "Spelaren satsar",
          "detail": "V2-kommandot anger heltalsbelopp, klientseed, roundId och förväntad revision."
        },
        {
          "id": "blackjack.reserve-ledger",
          "kind": "system",
          "nodeId": "node.ledger",
          "label": "Insatsen reserveras",
          "detail": "Application service committar motorns debit-intent, wallet, state, fairness, events och command receipt atomiskt i privat Postgres."
        },
        {
