{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "betId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "amount": {
      "type": "string",
      "maxLength": 11,
      "pattern": "^[1-9]\\d*$"
    },
    "currency": {
      "type": "string",
      "const": "PLAY"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "straight"
            },
            "pocket": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            }
          },
          "required": [
            "type",
            "pocket"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "split"
            },
            "pockets": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 36
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 36
                }
              ]
            }
          },
          "required": [
            "type",
            "pockets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "street"
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 34
            }
          },
          "required": [
            "type",
            "start"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "corner"
            },
            "topLeft": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          },
          "required": [
            "type",
            "topLeft"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "six-line"
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "required": [
            "type",
            "start"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "column": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                }
              ]
            }
          },
          "required": [
            "type",
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dozen"
            },
            "dozen": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                }
              ]
            }
          },
          "required": [
            "type",
            "dozen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "red-black"
            },
            "colour": {
              "type": "string",
              "enum": [
                "red",
                "black"
              ]
            }
          },
          "required": [
            "type",
            "colour"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "odd-even"
            },
            "parity": {
              "type": "string",
              "enum": [
                "odd",
                "even"
              ]
            }
          },
          "required": [
            "type",
            "parity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "low-high"
            },
            "range": {
              "type": "string",
              "enum": [
                "low",
                "high"
              ]
            }
          },
          "required": [
            "type",
            "range"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "betId",
    "amount",
    "currency",
    "selection"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.spelsajt.local/v2/roulette-bet.schema.json",
  "title": "Spelsajt roulette bet v2"
}
