{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "balance": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d{0,14}|[1-8]\\d{15}|900[0-6]\\d{12}|90070\\d{11}|90071[0-8]\\d{10}|900719[0-8]\\d{9}|9007199[0-1]\\d{8}|90071992[0-4]\\d{7}|900719925[0-3]\\d{6}|9007199254[0-6]\\d{5}|90071992547[0-3]\\d{4}|9007199254740[0-8]\\d{2}|90071992547409[0-8]\\d{1}|9007199254740990|9007199254740991)$"
    },
    "currency": {
      "type": "string",
      "const": "PLAY"
    },
    "games": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "blackjack",
              "roulette"
            ]
          },
          "lostRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mixedRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "net": {
            "type": "string",
            "maxLength": 65,
            "pattern": "^(?:0|-?[1-9]\\d*)$"
          },
          "pushedRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "returned": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:0|[1-9]\\d*)$"
          },
          "rounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wagered": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:0|[1-9]\\d*)$"
          },
          "wonRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "game",
          "lostRounds",
          "mixedRounds",
          "net",
          "pushedRounds",
          "returned",
          "rounds",
          "wagered",
          "wonRounds"
        ],
        "additionalProperties": false
      }
    },
    "recentRounds": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "blackjack",
              "roulette"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "win",
              "loss",
              "push",
              "mixed"
            ]
          },
          "payout": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:0|[1-9]\\d*)$"
          },
          "roundId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "settledAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "wager": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "game",
          "outcome",
          "payout",
          "roundId",
          "settledAt",
          "wager"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "totals": {
      "type": "object",
      "properties": {
        "lostRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mixedRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "net": {
          "type": "string",
          "maxLength": 65,
          "pattern": "^(?:0|-?[1-9]\\d*)$"
        },
        "pushedRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "returned": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        "rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wagered": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        "wonRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lostRounds",
        "mixedRounds",
        "net",
        "pushedRounds",
        "returned",
        "rounds",
        "wagered",
        "wonRounds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "balance",
    "currency",
    "games",
    "recentRounds",
    "schemaVersion",
    "totals"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.spelsajt.local/v2/account-summary.schema.json",
  "title": "Spelsajt account summary v2"
}
