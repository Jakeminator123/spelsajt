{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "lastSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "status": {
          "type": "string",
          "const": "accepted"
        },
        "tableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "lastSequence",
        "schemaVersion",
        "status",
        "tableId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "TABLE_NOT_FOUND",
                "INTERNAL_ERROR"
              ]
            },
            "detail": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "status": {
          "type": "string",
          "const": "rejected"
        }
      },
      "required": [
        "error",
        "schemaVersion",
        "status"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schemas.spelsajt.local/v2/table-subscription-ack.schema.json",
  "title": "Spelsajt table subscription acknowledgement v2"
}
