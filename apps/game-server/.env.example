GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=4000
# Comma-separated exact browser origins. Never use a wildcard in hosted environments.
WEB_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
# Use the local publishable/anon key here. A secret key is accepted server-side
# for hosted environments but must never be committed.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=
# Optional bounded Postgres overrides (defaults: 5000 ms / 10000 ms).
# GAME_SERVER_POSTGRES_CONNECTION_TIMEOUT_MS=5000
# GAME_SERVER_POSTGRES_STATEMENT_TIMEOUT_MS=10000
